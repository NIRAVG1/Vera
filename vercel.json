{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vera-bot": {
      "root": "bot_code",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "vera-bot"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "vera-bot"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "vera-bot"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ]
}
