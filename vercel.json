{
  "version": 2,
  "builds": [
    {
      "src": "bot_code/api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "bot_code/**/*.py",
          "bot_code/requirements.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "bot_code/api/index.py"
    }
  ]
}
